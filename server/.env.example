# 로컬 개발은 아무것도 없어도 된다 (포트 8787, 토큰 dev, DB 없음)
PORT=8787
DEV_TOKEN=dev
SESSION_TTL_MS=45000
# 운영: 대시보드 출처만 허용(S-28). 쉼표로 여럿(로컬 개발 대시보드를 같이 쓰면 ,http://localhost:5173). 비우면 모든 출처
# ALLOWED_DASHBOARD_ORIGIN=https://visitown.vercel.app
# 5단계(Supabase)에서 채운다. JWT_SECRET이 있으면 DEV_TOKEN은 무시된다
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# JWT_SECRET=
# 선택: 방문자 나라를 IP로 알아내려면 {ip} 자리가 있는 조회 주소. 비우면 프록시 나라 헤더(Cloudflare·Vercel)나 브라우저 시간대로 추정한다
# GEOIP_URL=http://ip-api.com/json/{ip}?fields=countryCode
# 원본 events 보관 일수(기본 7). page_daily 집계는 무기한. 하루 경계 시간대는 ROLLUP_TZ(기본 Asia/Seoul). docs/supabase.sql의 vt_rollup/vt_prune 함수가 필요하다
# EVENT_RETENTION_DAYS=7
# ROLLUP_TZ=Asia/Seoul
# 속도 제한·연결 상한(docs/security.md S-04·S-05). 기본값이면 비워 둔다: IP당 분당 이벤트 요청, IP당 분당 인증 실패(넘으면 1분 차단), 사이트당 SSE 구독 수
# EVENTS_PER_IP_MIN=1200
# AUTH_FAIL_PER_IP_MIN=60
# MAX_SSE_PER_SITE=200
# SSE 재접속 무손실(로드맵 44)·연결 폭주 캐시(로드맵 43): 사이트당 링버퍼 건수, 스트림 최대 수명(0=안 끊음), 스냅샷·발자국 캐시 ms(0=끔)
# SSE_BUFFER=1000
# SSE_MAX_AGE_MS=0
# SNAPSHOT_CACHE_MS=1000
# TRAILS_CACHE_MS=60000
# 수평 확장(로드맵 46): PEERS=1이면 Supabase Realtime broadcast로 다른 인스턴스와 이벤트·설정을 주고받는다(SUPABASE_URL·SERVICE_KEY 사용). 테스트·다른 릴레이는 PEER_WS_URL. 채널 이름·인스턴스 ID(기본 FLY_MACHINE_ID 또는 난수)
# 스트림 티켓 서명 비밀값(docs/security.md S-29). 비우면 JWT_SECRET, 그것도 없으면 프로세스마다 난수(서버 여러 대면 같은 값을 둔다). 만료는 STREAM_TICKET_TTL_MS(기본 30000)
# STREAM_TICKET_SECRET=
# PEERS=1
# PEER_WS_URL=
# PEER_CHANNEL=visitown
# INSTANCE_ID=
