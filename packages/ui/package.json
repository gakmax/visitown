{
  "name": "@visitown/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Visitown 대시보드의 React 패널(피드·정보·헤더 숫자, 로드맵 53). 엔진 인스턴스를 mount()로 받고 구독만 한다. 실시간 스트림(SSE)은 useSiteStream 훅(stream.ts, 로드맵 54)이 소유한다. 웹 앱(apps/web)은 TSX 소스를 그대로 가져오고, 테스트는 npm run build가 만든 dist/index.cjs(react 외부)를 렌더한다",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "src/index.tsx",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "require": "./dist/index.cjs"
    },
    "./stream": {
      "types": "./src/stream.ts",
      "import": "./src/stream.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=cjs --platform=node --target=es2022 --jsx=automatic --external:react --external:react-dom --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/index.cjs --log-level=warning"
  }
}
